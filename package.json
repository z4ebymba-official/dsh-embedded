{
  "name": "@local/board-lab",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Build, flash and read UART logs for ESP32, AVR, STM32 and AT32 boards — the board tools, the Board lab panel and the «Плата-дев» agent preset",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./monitor.py": "./monitor.py",
    "./host.js": "./host.js",
    "./agents/restrict": "./agents/restrict.js",
    "./maps/*.json": "./maps/*.json"
  },
  "files": [
    "index.js",
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "monitor.py",
    "agents/restrict.js",
    "tools/*.mjs",
    "maps/*.json",
    "docs/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
