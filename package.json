{
  "name": "@local/board-lab",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Build, flash and read UART logs for ESP32 and AT32 boards — the closed loop behind the dsh board tools and the Board lab panel",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./monitor.py": "./monitor.py",
    "./host.js": "./host.js"
  },
  "files": [
    "index.js",
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "monitor.py"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
